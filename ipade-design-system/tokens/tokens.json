      "950": { "$type": "color", "$value": "#00152B" },
      "900": { "$type": "color", "$value": "#001F3D" },
      "800": { "$type": "color", "$value": "#00284E" },
      "700": { "$type": "color", "$value": "#00305B", "$description": "Azul IPADE, color ancla de marca" },
      "600": { "$type": "color", "$value": "#14487A" },
      "500": { "$type": "color", "$value": "#1E5A96" },
      "400": { "$type": "color", "$value": "#4C82B8" },
      "300": { "$type": "color", "$value": "#8AAFD3" },
      "200": { "$type": "color", "$value": "#C0D6E9" },
      "100": { "$type": "color", "$value": "#E1ECF5" },
      "50":  { "$type": "color", "$value": "#F0F6FB" }
    },
    "gold": {
      "900": { "$type": "color", "$value": "#6B5219" },
      "800": { "$type": "color", "$value": "#8A6A24" },
      "700": { "$type": "color", "$value": "#9C7A2C" },
      "600": { "$type": "color", "$value": "#B08D3F", "$description": "Oro IPADE, acento" },
      "500": { "$type": "color", "$value": "#C6A65C" },
      "400": { "$type": "color", "$value": "#D9BF86" },
      "300": { "$type": "color", "$value": "#E9DDBF" },
      "200": { "$type": "color", "$value": "#F3EDDC" },
      "100": { "$type": "color", "$value": "#FAF7EF" }
    },
    "neutral": {
      "0":   { "$type": "color", "$value": "#FFFFFF" },
      "50":  { "$type": "color", "$value": "#F7F8FA" },
      "100": { "$type": "color", "$value": "#EFF1F4" },
      "200": { "$type": "color", "$value": "#DDE1E7" },
      "300": { "$type": "color", "$value": "#C2C8D1" },
      "400": { "$type": "color", "$value": "#9AA3B0" },
      "500": { "$type": "color", "$value": "#66707E" },
      "600": { "$type": "color", "$value": "#4D5561" },
      "700": { "$type": "color", "$value": "#343B45" },
      "800": { "$type": "color", "$value": "#20252C" },
      "900": { "$type": "color", "$value": "#10141A" }
