    "status": {
      "success": { "$type": "color", "$value": "#1E7A46" },
      "successSubtle": { "$type": "color", "$value": "#E3F3EA" },
      "warning": { "$type": "color", "$value": "#A96206" },
      "warningSubtle": { "$type": "color", "$value": "#FBEEDD" },
      "danger": { "$type": "color", "$value": "#B3261E" },
      "dangerSubtle": { "$type": "color", "$value": "#FBE7E5" },
      "info": { "$type": "color", "$value": "#1E5A96" },
      "infoSubtle": { "$type": "color", "$value": "#E1ECF5" }
    }
  },
  "semantic": {
    "bg": {
      "page": { "$value": "{color.neutral.0}" },
      "subtle": { "$value": "{color.neutral.50}" },
      "muted": { "$value": "{color.neutral.100}" },
      "brand": { "$value": "{color.navy.700}" },
      "brandStrong": { "$value": "{color.navy.900}" },
      "brandSubtle": { "$value": "{color.navy.50}" },
      "accent": { "$value": "{color.gold.600}" },
      "accentSubtle": { "$value": "{color.gold.100}" },
      "inverse": { "$value": "{color.navy.950}" },
      "overlay": { "$value": "rgba(0,21,43,0.72)" }
    },
    "text": {
      "primary": { "$value": "{color.neutral.900}" },
      "secondary": { "$value": "{color.neutral.600}" },
      "tertiary": { "$value": "{color.neutral.500}" },
      "disabled": { "$value": "{color.neutral.400}" },
      "brand": { "$value": "{color.navy.700}" },
      "accent": { "$value": "{color.gold.800}" },
      "onBrand": { "$value": "{color.neutral.0}" },
      "onAccent": { "$value": "{color.navy.950}" },
      "link": { "$value": "{color.navy.600}" },
      "linkHover": { "$value": "{color.navy.800}" }
    },
    "border": {
      "subtle": { "$value": "{color.neutral.200}" },
      "default": { "$value": "{color.neutral.300}" },
