      "accent": { "$value": "{color.gold.600}" },
      "focus": { "$value": "{color.navy.500}" }
    }
  },
  "font": {
    "family": {
      "display": { "$type": "fontFamily", "$value": ["Source Serif 4", "Georgia", "serif"] },
      "sans": { "$type": "fontFamily", "$value": ["Inter", "system-ui", "Helvetica Neue", "Arial", "sans-serif"] },
      "mono": { "$type": "fontFamily", "$value": ["IBM Plex Mono", "ui-monospace", "monospace"] }
    },
    "weight": {
      "regular": { "$type": "fontWeight", "$value": 400 },
      "medium": { "$type": "fontWeight", "$value": 500 },
      "semibold": { "$type": "fontWeight", "$value": 600 },
      "bold": { "$type": "fontWeight", "$value": 700 }
    },
    "size": {
      "3xs": { "$type": "dimension", "$value": "11px" },
      "2xs": { "$type": "dimension", "$value": "12px" },
      "xs":  { "$type": "dimension", "$value": "13px" },
      "sm":  { "$type": "dimension", "$value": "14px" },
      "md":  { "$type": "dimension", "$value": "16px" },
      "lg":  { "$type": "dimension", "$value": "18px" },
      "xl":  { "$type": "dimension", "$value": "21px" },
      "2xl": { "$type": "dimension", "$value": "26px", "$description": "fluido 22 → 26" },
      "3xl": { "$type": "dimension", "$value": "32px", "$description": "fluido 26 → 32" },
      "4xl": { "$type": "dimension", "$value": "40px", "$description": "fluido 32 → 40" },
      "5xl": { "$type": "dimension", "$value": "52px", "$description": "fluido 36 → 52" },
      "6xl": { "$type": "dimension", "$value": "72px", "$description": "fluido 44 → 72" }
    },
    "leading": {
      "none": { "$value": 1 },
      "tight": { "$value": 1.12 },
      "snug": { "$value": 1.28 },
      "normal": { "$value": 1.5 },
      "relaxed": { "$value": 1.65 },
      "loose": { "$value": 1.8 }
    },
    "tracking": {
      "tighter": { "$value": "-0.02em" },
      "tight": { "$value": "-0.01em" },
      "normal": { "$value": "0" },
      "wide": { "$value": "0.04em" },
      "wider": { "$value": "0.12em" }
    }
  },
  "space": {
    "0": { "$type": "dimension", "$value": "0px" },
    "1": { "$type": "dimension", "$value": "4px" },
    "2": { "$type": "dimension", "$value": "8px" },
    "3": { "$type": "dimension", "$value": "12px" },
    "4": { "$type": "dimension", "$value": "16px" },
    "5": { "$type": "dimension", "$value": "20px" },
    "6": { "$type": "dimension", "$value": "24px" },
    "8": { "$type": "dimension", "$value": "32px" },
    "10": { "$type": "dimension", "$value": "40px" },
    "12": { "$type": "dimension", "$value": "48px" },
    "16": { "$type": "dimension", "$value": "64px" },
    "20": { "$type": "dimension", "$value": "80px" },
    "24": { "$type": "dimension", "$value": "96px" },
    "32": { "$type": "dimension", "$value": "128px" },
    "40": { "$type": "dimension", "$value": "160px" }
  },
  "radius": {
    "none": { "$value": "0px" },
    "xs": { "$value": "2px" },
    "sm": { "$value": "4px" },
    "md": { "$value": "8px" },
    "lg": { "$value": "12px" },
    "xl": { "$value": "20px" },
    "pill": { "$value": "999px" }
  },
  "shadow": {
    "xs": { "$value": "0 1px 2px rgba(0,31,61,0.06)" },
    "sm": { "$value": "0 2px 6px rgba(0,31,61,0.08)" },
    "md": { "$value": "0 8px 20px rgba(0,31,61,0.10)" },
    "lg": { "$value": "0 16px 40px rgba(0,31,61,0.14)" },
    "xl": { "$value": "0 28px 64px rgba(0,31,61,0.18)" },
    "focus": { "$value": "0 0 0 3px rgba(30,90,150,0.35)" }
  },
  "motion": {
    "duration": {
      "instant": { "$value": "80ms" },
      "fast": { "$value": "140ms" },
      "base": { "$value": "220ms" },
      "slow": { "$value": "340ms" },
      "deliberate": { "$value": "520ms" }
    },
    "easing": {
      "standard": { "$value": "cubic-bezier(0.2,0,0,1)" },
      "entrance": { "$value": "cubic-bezier(0,0,0,1)" },
      "exit": { "$value": "cubic-bezier(0.3,0,1,1)" },
      "emphasis": { "$value": "cubic-bezier(0.2,0,0,1.2)" }
    }
  },
  "breakpoint": {
    "xs": { "$value": "360px" },
    "sm": { "$value": "600px" },
    "md": { "$value": "768px" },
    "lg": { "$value": "1024px" },
    "xl": { "$value": "1280px" },
    "2xl": { "$value": "1440px" }
  },
  "zIndex": {
    "base": { "$value": 0 },
    "raised": { "$value": 10 },
    "sticky": { "$value": 100 },
    "header": { "$value": 200 },
    "dropdown": { "$value": 300 },
    "floatingCta": { "$value": 400 },
    "overlay": { "$value": 500 },
    "modal": { "$value": 600 },
    "toast": { "$value": 700 },
    "tooltip": { "$value": 800 }
  }
}
